# ---- Copy to .env.local for local dev. Set the same keys in Vercel project settings. Never commit real values. ----
# Runner (PC): copy the runner-only keys and the Upstash keys into scripts/.env or runner.env. Never commit either file.

# ---- Worker vars (non-secret config) ----

# Public origin for OAuth redirects, e.g. https://workflwpro.vercel.app. Unset = use the request origin.
APP_ORIGIN=http://localhost:3000

# Comma-separated GitHub logins allowed to sign in (case-insensitive). Empty denies everyone.
ALLOWED_USERS=

# GitHub OAuth app client ID (public part of the OAuth app).
GITHUB_CLIENT_ID=

# Upstash Redis REST URL. Unset locally = in-memory store, dev only (state lost on restart). The runner also reads it.
UPSTASH_REDIS_REST_URL=

# Model IDs for each tier. Defaults shown. Workers fall back to LEAD_MODEL when a run has no leads.
ORCHESTRATOR_MODEL=claude-opus-5-5
LEAD_MODEL=claude-sonnet-5-5
WORKER_MODEL=claude-haiku-5-5

# Optional: comma-separated stock tickers for the dashboard ticker bar. Empty hides it. Example: AAPL,MSFT,NVDA
TICKER_SYMBOLS=

# ---- Worker secrets (Vercel only; never commit) ----

# HMAC key for the signed session cookie. At least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=

# GitHub OAuth app client secret, paired with GITHUB_CLIENT_ID.
GITHUB_CLIENT_SECRET=

# GitHub token used by the merge route (app/api/runs/[id]/merge) and the GitHub client in lib/engine.ts.
GITHUB_TOKEN=

# Upstash Redis REST token, paired with UPSTASH_REDIS_REST_URL. The runner also reads it.
UPSTASH_REDIS_REST_TOKEN=

# ---- Runner-only (PC, scripts/runner.ts; never set in Vercel) ----

# Claude Code OAuth token from the owner's subscription. The only key agents use to bill. ANTHROPIC_API_KEY is ignored.
CLAUDE_CODE_OAUTH_TOKEN=
