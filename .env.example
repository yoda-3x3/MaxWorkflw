# ---- WorkflwPro env template. ----
# Two places use these names:
#   1. Cloudflare Worker: vars live in wrangler.jsonc. Secrets are set with `npx wrangler secret put <NAME>`.
#      Local dev: copy this file to .dev.vars and fill it in (never commit it).
#   2. PC runner (scheduled task): copy the runner block below to runner.env at the repo root.
#      runner.env is git-ignored. It holds CLAUDE_CODE_OAUTH_TOKEN, so it never goes to the Worker.
# Provisional: the final list is set once backend and auth-ui finish.

# ---- Worker vars (non-secret; also set in wrangler.jsonc) ----
APP_ORIGIN=https://workflwpro.flitetest-bhs.workers.dev
ALLOWED_USERS=yoda-3x3
TICKER_SYMBOLS=AAPL,TSLA,PLTR,GLD

# ---- Worker secrets (wrangler secret put) ----
# Access control and sessions. SESSION_SECRET: openssl rand -base64 32
SESSION_SECRET=

# GitHub OAuth app (sign-in with GitHub)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Upstash Redis (REST). Shared by the Worker and the runner.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Only if the site code still calls the GitHub API. The runner uses the PC's git/gh credentials instead.
GITHUB_TOKEN=

# Models (defaults shown). Used by the runner.
ORCHESTRATOR_MODEL=claude-opus-5-5
LEAD_MODEL=claude-sonnet-5-5
WORKER_MODEL=claude-haiku-5-5

# ---- PC runner env (runner.env only, never a Worker secret) ----
# Claude Code OAuth token. Bills the owner's subscription. Generate with `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# Same Upstash database as the Worker
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Run id the runner advances. Set by the scheduled task, not by hand.
# RUN_ID=
