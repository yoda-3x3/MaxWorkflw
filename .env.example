# ---- Copy to .env.local for local dev. Production runs on Cloudflare Workers: vars live in wrangler.jsonc, secrets via `wrangler secret put`. Never commit real values. ----
# Runner (PC): copy the runner-only keys and the Upstash keys into scripts/.env or runner.env. Never commit either file.

# ---- Worker vars (non-secret config; set in wrangler.jsonc "vars" for production) ----

# Public origin for OAuth redirects, e.g. https://workflwpro.pages.dev. Unset = use the request origin.
APP_ORIGIN=http://localhost:3000

# Comma-separated GitHub logins allowed to sign in (case-insensitive). Empty denies everyone.
ALLOWED_USERS=

# Optional: comma-separated stock tickers for the dashboard ticker bar. Empty hides it. Example: AAPL,MSFT,NVDA
TICKER_SYMBOLS=

# Model IDs for each tier. Defaults shown. Workers fall back to LEAD_MODEL when a run has no leads.
ORCHESTRATOR_MODEL=claude-opus-5-5
LEAD_MODEL=claude-sonnet-5-5
WORKER_MODEL=claude-haiku-5-5

# ---- Worker secrets (set with `wrangler secret put <NAME>` for production; never commit) ----

# HMAC key for the signed session cookie. At least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=

# GitHub OAuth app client ID and secret (sign-in with GitHub).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub token used by the merge route (app/api/runs/[id]/merge) and the GitHub client in lib/engine.ts.
GITHUB_TOKEN=

# Upstash Redis REST URL and token. Unset locally = in-memory store, dev only (state lost on restart). The runner also reads both.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Runner-only (PC, scripts/runner.ts; never set in Cloudflare) ----

# Claude Code OAuth token from the owner's subscription. The only key agents use to bill. ANTHROPIC_API_KEY is ignored.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: folder where run workspaces are kept. Unset = %LOCALAPPDATA%\workflwpro\runs.
RUNNER_WORK_DIR=
