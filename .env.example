# ---- WorkflwPro env template. Never commit real values. ----
# 1. Cloudflare Worker: vars are in wrangler.jsonc. Secrets are set with `npx wrangler secret put <NAME>`.
#    Local dev: copy the Worker block to .dev.vars (git-ignored).
# 2. PC runner: copy the runner block to scripts/.env or runner.env (both git-ignored).
#    It holds CLAUDE_CODE_OAUTH_TOKEN, so it never goes to the Worker.

# ---- Worker vars (non-secret; also set in wrangler.jsonc) ----
APP_ORIGIN=https://workflwpro.flitetest-bhs.workers.dev
ALLOWED_USERS=yoda-3x3
TICKER_SYMBOLS=AAPL,TSLA,PLTR,GLD

# ---- Worker secrets (wrangler secret put) ----
# HMAC key for the signed session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# GitHub OAuth app (sign-in with GitHub)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub token for the merge route
GITHUB_TOKEN=

# Upstash Redis (REST). Same database as the runner.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- PC runner env (scripts/.env or runner.env only, never a Worker secret) ----
# Claude Code OAuth token. Bills the owner's subscription. Create with `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# Same Upstash database as the Worker
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional model overrides (defaults shown). Used by the runner.
ORCHESTRATOR_MODEL=claude-opus-5-5
LEAD_MODEL=claude-sonnet-5-5
WORKER_MODEL=claude-haiku-5-5
