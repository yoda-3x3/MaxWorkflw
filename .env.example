# ---- Copy to .env.local for local dev. Set the same keys in Vercel project settings. Never commit real values. ----

# Anthropic (one shared key for all users)
ANTHROPIC_API_KEY=
# Models (defaults shown). Workers fall back to LEAD_MODEL when a run has no leads.
ORCHESTRATOR_MODEL=claude-opus-5-5
LEAD_MODEL=claude-sonnet-5-5
WORKER_MODEL=claude-haiku-5-5

# Access control. Comma-separated emails and/or GitHub logins. Empty list denies everyone.
ALLOWED_USERS=

# Sessions: HMAC key for the signed session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# GitHub OAuth app (sign-in with GitHub) and token for repo mode (read, branch, commit, open PR)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

# Magic-link email via Resend
RESEND_API_KEY=
RESEND_FROM=

# Upstash Redis (REST). Unset locally = in-memory fallback, dev only (state lost on restart).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret for cron and the step endpoint. Bearer auth only. Generate with: openssl rand -hex 32
CRON_SECRET=

# Public base URL, used for OAuth callbacks, magic links and self-calls. Example: https://maxworkflw.vercel.app
APP_URL=http://localhost:3000

# Optional: comma-separated stock tickers shown in the dashboard ticker bar. Example: AAPL,MSFT,NVDA
TICKER_SYMBOLS=
